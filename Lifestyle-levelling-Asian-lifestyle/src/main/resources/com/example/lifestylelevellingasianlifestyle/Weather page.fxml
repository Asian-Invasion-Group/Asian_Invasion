<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="540.0" prefWidth="850.0" stylesheets="@background.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lifestylelevellingasianlifestyle.WeatherService">
   <top>
      <AnchorPane BorderPane.alignment="CENTER">
            <Button fx:id="profileButton" layoutY="-2.0" mnemonicParsing="false" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="-2.0" onAction="#onProfile">
               <graphic>
                  <ImageView fitHeight="133.0" fitWidth="166.0" pickOnBounds="true" preserveRatio="true">
                     <Image url="@../../../Images/Profile.png" />
                  </ImageView>
               </graphic></Button>

                     <Label alignment="TOP_CENTER" text="Weather" textOverrun="CLIP" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="25.0">
               <font>
                  <Font name="System Bold Italic" size="24.0" />
               </font>
            </Label>
      </AnchorPane>
   </top>
   <left>
      <VBox prefHeight="200.0" prefWidth="107.0" BorderPane.alignment="CENTER">
            <Button fx:id="homeButton" mnemonicParsing="false" onAction="#onHome" prefHeight="100.0">
               <graphic>
                  <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../../../Images/Home.png" />
                  </ImageView>
               </graphic></Button>

            <Button fx:id="groceryButton" mnemonicParsing="false" onAction="#onGroceries" prefHeight="100.0">
               <graphic>
                  <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../../../Images/Grocery.png" />
                  </ImageView>
               </graphic></Button>

            <Button fx:id="weatherButton" mnemonicParsing="false" onAction="#onWeather" prefHeight="100.0">
               <graphic>
                  <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../../../Images/Weather.png" />
                  </ImageView>
               </graphic></Button>

            <Button fx:id="utilityButton" mnemonicParsing="false" onAction="#onUtilities" prefHeight="100.0">
               <graphic>
                  <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../../../Images/Utility.png" />
                  </ImageView>
               </graphic></Button>
      </VBox>
   </left>

    <center>
        <AnchorPane BorderPane.alignment="CENTER">
            <VBox layoutX="45.0" layoutY="44.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="88.0" AnchorPane.topAnchor="10.0">
                <AnchorPane>
                    <Label alignment="CENTER" text="Currently" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font></Label>

                        <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true" fx:id="currentWeatherImage" >
                            <Image url="@../../../Images/weatherImages/0.png" />
                        </ImageView>
                    <Label alignment="CENTER" text="Weather Placeholder" fx:id="currentWeatherText" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="25.0">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font></Label>

                </AnchorPane>
                <AnchorPane prefHeight="400.0" prefWidth="250.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitWidth="40.0"
                                   fitHeight="40.0"
                                   preserveRatio="true">
                            <Image url="@../../../Images/weatherImages/0.png"/>
                        </ImageView>

                        <Label text="Clear Sky (28.7°C)">
                            <font>
                                <Font name="System Bold" size="15.0"/>
                            </font>
                        </Label>
                    </HBox>
                </AnchorPane>
            </VBox>
            <VBox layoutX="329.0" layoutY="70.0" prefHeight="321.0" prefWidth="249.0" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="88.0" AnchorPane.topAnchor="10.0">
                <AnchorPane>
                    <Label alignment="CENTER" text="Recommendations" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="2.0">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>



                    <ImageView fitHeight="275.0" fitWidth="275.0" pickOnBounds="true" preserveRatio="true" fx:id="currentRecommendations" >
                        <Image url="@../../../Images/weatherImages/0.png" />
                    </ImageView>
                    <Label alignment="CENTER" text="Recommendation Placeholder" fx:id="currentRecommendationText" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font></Label>
                </AnchorPane>

            </VBox>
        </AnchorPane>
    </center>
</BorderPane>
