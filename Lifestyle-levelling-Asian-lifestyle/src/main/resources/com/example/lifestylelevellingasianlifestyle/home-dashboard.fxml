<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lifestylelevellingasianlifestyle.HomepageController">
   <top>
      <AnchorPane BorderPane.alignment="CENTER">
         <children>
            <Button layoutY="-2.0" mnemonicParsing="false" prefHeight="111.0" prefWidth="125.0" text="Profile" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="-2.0" />
   
                     <Label alignment="TOP_CENTER" text="Welcome to Lifestyle Levelling, [Username]" textOverrun="CLIP" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="25.0">
               <font>
                  <Font name="System Bold Italic" size="24.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </top>
   <left>
      <VBox prefHeight="200.0" prefWidth="107.0" BorderPane.alignment="CENTER">
         <children>
            <Button id="Home" mnemonicParsing="false" prefHeight="237.0" prefWidth="107.0" text="Home" />
            <Button id="Grocery" fx:id="Grocery" mnemonicParsing="false" onAction="#onExistingGroceries" prefHeight="237.0" prefWidth="108.0" text="Grocery" />
            <Button mnemonicParsing="false" prefHeight="237.0" prefWidth="108.0" text="Weather" />
            <Button mnemonicParsing="false" prefHeight="237.0" prefWidth="108.0" text="Utility Track " />
         </children>
      </VBox>
   </left>
   <right>
        <VBox alignment="CENTER" prefHeight="450.0" prefWidth="720.0" spacing="20" BorderPane.alignment="CENTER">

            <Button fx:id="groceryListButton" onAction="#onGroceryList" text="Grocery List" />

            <Button fx:id="existingGroceriesButton" onAction="#onExistingGroceries" text="Existing Groceries" />

        </VBox>
   </right>
   <center>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
