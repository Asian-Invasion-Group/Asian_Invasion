<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="540.0" prefWidth="850.0" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lifestylelevellingasianlifestyle.HomepageController">
   <top>
      <AnchorPane BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="profileButton" layoutY="-2.0" mnemonicParsing="false" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="-2.0">
               <graphic>
                  <ImageView fitHeight="131.0" fitWidth="166.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../Images/Profile.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
   
                     <Label alignment="TOP_CENTER" text="Welcome to Lifestyle Levelling, [Username]" textOverrun="CLIP" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="25.0">
               <font>
                  <Font name="System Bold Italic" size="24.0" />
               </font>
            </Label>
            <Button fx:id="signoutButton" mnemonicParsing="false" onAction="#onSignout" text="Sign Out" AnchorPane.bottomAnchor="40.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="40.0" />
         </children>
      </AnchorPane>
   </top>
   <left>
      <VBox alignment="TOP_CENTER" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="homeButton" mnemonicParsing="false" onAction="#onHome" prefHeight="100.0">
               <graphic>
                  <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../Images/Home.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="Grocery" mnemonicParsing="false" onAction="#onGroceries" prefHeight="100.0">
               <graphic>
                  <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../Images/Grocery.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="weatherButton" mnemonicParsing="false" onAction="#onWeather" prefHeight="100.0">
               <graphic>
                  <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../Images/Weather.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="utilityButton" mnemonicParsing="false" onAction="#onUtilities" prefHeight="100.0">
               <graphic>
                  <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../Images/Utility.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
         </children>
      </VBox>
   </left>
</BorderPane>
