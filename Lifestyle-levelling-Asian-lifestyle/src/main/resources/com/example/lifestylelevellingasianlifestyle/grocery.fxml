<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="450.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lifestylelevellingasianlifestyle.HomepageController">
   <top>
      <AnchorPane BorderPane.alignment="CENTER">
         <children>
            <Button layoutY="-2.0" mnemonicParsing="false" prefHeight="111.0" prefWidth="125.0" text="Profile" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="-2.0" />

                     <Label alignment="TOP_CENTER" text="Grocery" textOverrun="CLIP" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="25.0">
               <font>
                  <Font name="System Bold Italic" size="24.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </top>
   <left>
      <VBox prefHeight="200.0" prefWidth="107.0" BorderPane.alignment="CENTER">
         <children>
            <Button id="Home" mnemonicParsing="false" prefHeight="237.0" prefWidth="107.0" text="Home" />
            <Button mnemonicParsing="false" prefHeight="237.0" prefWidth="108.0" text="Weather" />
            <Button mnemonicParsing="false" prefHeight="237.0" prefWidth="108.0" text="Utility Track " />
         </children>
      </VBox>
   </left>
   <center>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <VBox layoutX="45.0" layoutY="44.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="10.0">
               <children>
                  <AnchorPane>
                     <children>
                        <Label alignment="CENTER" text="Existing Groceries" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font></Label>
                     </children>
                  </AnchorPane>
                  <AnchorPane prefHeight="400.0" prefWidth="250.0">
                     <children>
                        <TableView fx:id="groceryTable" prefHeight="249.0" prefWidth="245.0" AnchorPane.bottomAnchor="-1.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="0.0">
                          <columns>
                             <TableColumn fx:id="existingNameColumn" text="Item Name" />
                             <TableColumn fx:id="expiryColumn" text="Expiry Date" />
                             <TableColumn fx:id="dateAddedColumn" text="Date Added" />
                          </columns>
                        </TableView>
                     </children>
                  </AnchorPane>
                  <AnchorPane prefHeight="200.0">
                     <children>
                        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <children>
                              <Button onAction="#onRemoveExistingItem" text="Remove Selected" />
                           </children>
                        </HBox>
                     </children>
                  </AnchorPane>
               </children>
            </VBox>
            <VBox layoutX="329.0" layoutY="70.0" prefHeight="321.0" prefWidth="249.0" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="10.0">
               <children>
                  <AnchorPane>
                     <children>
                        <Label alignment="CENTER" text="Grocery List" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </AnchorPane>
                  <AnchorPane prefHeight="400.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="groceryListTable" layoutX="-8.666666666666666" prefHeight="248.0" prefWidth="253.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="-9.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="0.0">
                           <columns>
                              <TableColumn fx:id="groceryNameColumn" text="Item Name"/>
                              <TableColumn fx:id="quantityColumn" text="Quantity"/>
                           </columns>
                        </TableView>
                     </children>
                  </AnchorPane>
                  <AnchorPane prefHeight="200.0" prefWidth="243.0">
                     <children>
                        <HBox prefHeight="25.0" prefWidth="237.0">
                           <children>
                              <Button onAction="#onAddItem" prefHeight="25.0" prefWidth="61.0" text="Add" />
                              <Button onAction="#onRemoveListItem" text="Remove" />
                              <Button onAction="#onMoveToExisting" prefHeight="25.0" prefWidth="120.0" text="Move to Existing" />
                           </children>
                        </HBox>
                     </children>
                  </AnchorPane>
               </children></VBox>
         </children>
      </AnchorPane>
   </center>
</BorderPane>
